# hermes-agent-setup: 環境変数テンプレート
# 使い方: このファイルをコピーして REPLACE_ME を実キーに差し替え、
#   cp env.example ~/.hermes-intel.env && chmod 600 ~/.hermes-intel.env
#   source ~/.hermes-intel.env
# 注意: 実キーを書いたファイルは絶対に git にコミットしないこと。

# --- 必須: xAI (Grok) — X/ウェブ検索用 ---
# 入手先: https://console.x.ai
export XAI_API_KEY="xai-REPLACE_ME"

# --- 任意: Hermes Agent の推論エンジン用（いずれか1つでよい） ---
# export OPENROUTER_API_KEY="sk-or-REPLACE_ME"
# export ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
# export OPENAI_API_KEY="sk-REPLACE_ME"
